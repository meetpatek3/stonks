# Copy to .env / use Vercel env for production. Never commit secrets.
HEROUI_AUTH_TOKEN=

# Session signing secret (min 16 chars)
AUTH_SECRET=

# Bootstrap credentials for the first household (used once when DB is empty)
AUTH_USERNAME=
AUTH_PASSWORD=

# Postgres — MUST be local Docker for day-to-day work and `pnpm test`.
# Never put production Neon here; a mistaken Vercel env pull previously wiped
# orphans into prod when integration tests ran.
DATABASE_URL=postgresql://stonks:stonks@127.0.0.1:5432/stonks

# Neon / Vercel production DB (ops only). Pull separately:
#   vercel env pull .env.vercel --environment=production
# Then migrate with: pnpm migrate:neon
# Do not copy DATABASE_URL from .env.vercel into .env.local.

# Market data (optional). Leave empty to self-host with no external dependency:
# the fixture price provider is the default and the app runs without an account.
# Set it to fetch real closing prices from Twelve Data (free tier ~800 req/day).
TWELVEDATA_API_KEY=
